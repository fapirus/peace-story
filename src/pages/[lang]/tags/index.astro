---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { resolveLocale, SUPPORTED_LOCALES } from "@/i18n/config";
import { slugifyTag } from "@/utils/tags";

export const getStaticPaths = () =>
	SUPPORTED_LOCALES.map(({ code }) => ({
		params: { lang: code },
	}));

const locale = resolveLocale(Astro.params.lang);

const posts = (await getCollection("blogs")).filter(
	(entry) => entry.data.locale === locale,
);

const tagsMap = new Map<string, { label: string; count: number }>();

posts.forEach((post) => {
	post.data.tags?.forEach((tag) => {
		const slug = slugifyTag(tag);
		const key = `${locale}:${slug}`;
		const current = tagsMap.get(key);
		if (current) {
			current.count += 1;
		} else {
			tagsMap.set(key, { label: tag, count: 1 });
		}
	});
});

const tags = Array.from(tagsMap.entries())
	.map(([key, value]) => ({
		slug: key.split(":")[1],
		label: value.label,
		count: value.count,
	}))
	.sort((a, b) => a.label.localeCompare(b.label));

const headingText = locale === "ko" ? "태그" : "Tags";
const description =
	locale === "ko"
		? "태그를 선택해 관련 글을 빠르게 찾아보세요."
		: "Browse every tag to jump into topics quickly.";
---

<Layout locale={locale} title={`${headingText} | Kiri`}>
	<main class="mx-auto my-8 flex flex-col gap-6 max-sm:px-4 sm:max-w-sm md:max-w-xl lg:max-w-3xl">
		<header class="text-center">
			<p class="text-sm uppercase tracking-[0.35em] text-foreground/50">
				{headingText}
			</p>
			<p class="text-muted mt-2 text-base">{description}</p>
		</header>

		{tags.length === 0 ? (
			<p class="text-center text-sm text-muted">
				{locale === "ko"
					? "아직 등록된 태그가 없습니다."
					: "No tags have been published yet."}
			</p>
		) : (
			<ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
				{tags.map((tag) => (
					<li>
						<a
							href={`/${locale}/tags/${tag.slug}`}
							class="flex items-center justify-between rounded-2xl border border-foreground/10 bg-background/80 px-4 py-3 text-sm shadow-sm transition hover:border-ultramarine/40 hover:bg-ultramarine/5 dark:bg-muted/40"
						>
							<span class="font-semibold text-foreground">#{tag.label}</span>
							<span class="text-muted text-xs">
								{locale === "ko" ? `${tag.count}개의 글` : `${tag.count} posts`}
							</span>
						</a>
					</li>
				))}
			</ul>
		)}
	</main>
</Layout>
