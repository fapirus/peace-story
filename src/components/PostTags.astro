---
import type { CollectionEntry } from "astro:content";
import type { LocaleCode } from "@/i18n/config";
import { slugifyTag } from "@/utils/tags";

interface Props {
	tags: CollectionEntry<"blogs">["data"]["tags"];
	locale: LocaleCode;
}

const { tags, locale } = Astro.props;
---

{
	tags && (
		<div class="mt-2 flex flex-wrap justify-center gap-2">
			{tags.map((tag) => (
				<a
					href={`/${locale}/tags/${slugifyTag(tag)}`}
					class="text-muted/70 border-muted/20 hover:border-ultramarine/40 hover:bg-ultramarine/5 hover:text-foreground inline-block rounded-full border px-3 py-1 text-sm"
				>
					#{tag}
				</a>
			))}
		</div>
	)
}
