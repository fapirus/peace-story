---
import Logo from "@/icons/logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SkipToContent from "./SkipToContent.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import type { LanguageOption, LocaleCode } from "@/i18n/config";

interface Props {
	locale: LocaleCode;
	languageOptions: LanguageOption[];
}

const { locale, languageOptions } = Astro.props;

const isBlogPage = Astro.url.pathname.includes("/blog/");
const blogLabel = locale === "ko" ? "블로그" : "Blogs";
---

<header
	data-site-header
	class="group/header text-foreground/80 text-md sticky top-0 z-40 mb-10 w-full border-b border-foreground/5 transition-all duration-200 ease-out bg-background data-[scrolled=true]:bg-background data-[scrolled=true]:text-foreground data-[scrolled=true]:shadow-sm dark:bg-[#050505] dark:border-foreground/10 dark:data-[scrolled=true]:bg-[#0b0b0b]"
>
	{isBlogPage && <SkipToContent slot="skip-to-content" />}
	<nav
		class="mx-auto flex h-16 items-center justify-between transition-[height,padding] duration-200 ease-out max-sm:px-4 sm:max-w-sm md:max-w-xl lg:max-w-3xl group-data-[scrolled=true]/header:h-14"
	>
			<a href={`/${locale}`} class="flex items-center space-x-1.5">
				<Logo class="h-6 w-6 rounded-full p-0.5" />
			</a>
			<div class="flex items-center space-x-4">
				<a href={`/${locale}`}>{blogLabel}</a>
				<LanguageSwitcher locale={locale} options={languageOptions} />
				<ThemeToggle />
			</div>
		</nav>
</header>

<script>
	const setupHeaderState = () => {
		const header = document.querySelector(
			"[data-site-header]",
		) as HTMLElement | null;

		if (!header) return;

		const updateHeaderState = () => {
			header.dataset.scrolled = window.scrollY > 16 ? "true" : "false";
		};

		// Avoid duplicate listeners when navigating between pages.
		document.removeEventListener("scroll", updateHeaderState);
		document.addEventListener("scroll", updateHeaderState, { passive: true });

		updateHeaderState();
	};

	document.addEventListener("astro:page-load", setupHeaderState);
</script>
