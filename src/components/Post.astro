---
import type { CollectionEntry } from "astro:content";
import type { LocaleCode } from "@/i18n/config";
import { getSlugSegment } from "@/utils/content";
import { slugifyTag } from "@/utils/tags";

type Props = {
	blog: CollectionEntry<"blogs">;
	locale: LocaleCode;
};

const { blog, locale } = Astro.props;
const { title, publishedDate, tags } = blog.data;
const slugSegment = getSlugSegment(blog);

const formattedDate = new Intl.DateTimeFormat(locale, {
	year: "numeric",
	month: "short",
	day: "numeric",
}).format(publishedDate);
---

<article
	class="group/article flex w-full items-start justify-between gap-4 transition-opacity duration-150 ease-in-out group-hover:opacity-45 hover:opacity-100"
>
	<div class="flex-1">
		<a
			href={`/${locale}/blog/${slugSegment}`}
			class="text-muted inline-block text-pretty"
		>
			<h2
				class="decoration-ultramarine decoration-wavy decoration-2 underline-offset-2 group-hover/article:underline max-sm:text-sm dark:decoration-ultramarine"
				set:html={title}
			/>
		</a>
		{tags?.length > 0 && (
			<ul class="mt-2 flex flex-wrap gap-1 text-[0.55rem] uppercase tracking-[0.18em] text-muted/70">
				{tags.slice(0, 3).map((tag) => (
					<li>
						<a
							href={`/${locale}/tags/${slugifyTag(tag)}`}
							class="rounded-full border border-foreground/5 bg-foreground/[0.03] px-2 py-0.5 text-foreground/60 transition hover:border-ultramarine/30 hover:bg-ultramarine/5 hover:text-foreground"
						>
							#{tag}
						</a>
					</li>
				))}
				{tags.length > 3 && (
					<li class="rounded-full border border-foreground/5 bg-background/90 px-2 py-0.5 text-[0.55rem] text-muted/60">
						+{tags.length - 3}
					</li>
				)}
			</ul>
		)}
	</div>
	<p class="text-muted text-sm whitespace-nowrap">
		{formattedDate}
	</p>
</article>
